# ==============================================================================
# CONFIGURAZIONE AMBIENTE CIVICO "LA NOSTRA CITTÀ, IL NOSTRO FUTURO"
# Copiare questo file in .env per l'ambiente applicativo o in .env.test per il collaudo.
# NON committare credenziali reali e NON condividerle nei log o nei repository.
# ==============================================================================

# 1. URL PUBBLICO DELL'APPLICAZIONE (usato nei link inviati via email)
# Non usare localhost per email destinate a essere aperte da dispositivi esterni
APP_URL="http://localhost:3000"

# 2. TRASPORTO EMAIL SMTP REALE
# Configurare un server SMTP (es. Mailtrap per staging, Brevo, Sendgrid, o SMTP comunale/aziendale).
# Se non configurato in sviluppo, il sistema accoda le email nell'Outbox segnalando lo stato all'utente.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false" # impostare a "true" per porta 465 (SSL/TLS nativo)
SMTP_USER="apikey_or_username"
SMTP_PASS="secret_password_or_token"
EMAIL_FROM="La Nostra Città <noreply@lanostracitta.it>"

# 3. DATABASE MYSQL AIVEN (Ambiente Applicativo / Dimostrativo)
# Stringa di connessione su database applicativo (defaultdb).
# Nota: il file ca.pem deve essere presente nella root del progetto per la connessione TLS.
DATABASE_URL="mysql://avnadmin:PASSWORD@mysql-XXXXXXXX-progetto.aivencloud.com:11582/defaultdb?sslaccept=strict&sslcert=ca.pem"

# 4. GUARDIE DI SICUREZZA PER TEST AUTOMATICI (.env.test)
# Da configurare esclusivamente in .env.test per autorizzare l'esecuzione su 'la_nostra_citta_test':
# AUTHORIZED_TEST_HOST="mysql-XXXXXXXX-progetto.aivencloud.com"
# AUTHORIZED_TEST_PORT="11582"

# 5. SERVIZIO DI GEOCODIFICA E RICERCA INDIRIZZI
# Predefinito: OpenStreetMap Nominatim con contesto Milano e rispetto delle policy OSMF.
# - Nessun autocomplete durante la digitazione (vietato dalla policy OSMF)
# - Coda di rate-limiting aggregata per l'intera app (max 1 richiesta al secondo)
# - Cache in-memory delle risposte per 24 ore
# - Attribuzione obbligatoria ODbL 1.0 visibile
# Se si desidera utilizzare un provider alternativo con credenziali dedicate:
# GEOCODING_PROVIDER="nominatim" # opzioni supportate: "nominatim", "locationiq", "opencage"
# GEOCODING_API_KEY=""

# 6. PIPELINE IA E ADATTATORI (Fase 5)
# Modalità adattatori: "mock" (predefinito deterministico per CI e test) o "real" (parser EXIF nativo + provider esterno protetto)
AI_ADAPTER_MODE="mock"
# In modalità reale, l'estrazione metadati EXIF è eseguita in locale senza costi dal parser binario nativo.
# Per la moderazione NLP reale con provider commerciale (es. OpenAI Moderations API):
# AI_MODERATION_API_KEY="sk-..."
# AI_MODERATION_ENDPOINT="https://api.openai.com/v1/moderations"


