# ==============================================================================
# CONFIGURAZIONE COLLAUDO AIVEN (.env.test)
# Copiare questo file in .env.test nella root del progetto.
# NON committare credenziali reali e NON condividerle in chat.
# ==============================================================================

# 1. Host e Porta Aiven autorizzati (OBBLIGATORI per le guardie di sicurezza)
AUTHORIZED_TEST_HOST="mysql-XXXXXXXX-progetto.aivencloud.com"
AUTHORIZED_TEST_PORT="11582"

# 2. Stringa di connessione obbligatoriamente su 'la_nostra_citta_test'
#    TLS strict abilitato con 'sslaccept=strict'.
#    Certificato CA: indicare il percorso assoluto o relativo alla root (es. certs/ca.pem).
DATABASE_URL="mysql://avnadmin:PLACEHOLDER_PASSWORD@mysql-XXXXXXXX-progetto.aivencloud.com:11582/la_nostra_citta_test?sslaccept=strict&sslcert=certs/ca.pem"

