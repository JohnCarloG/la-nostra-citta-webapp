generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Quartiere {
  id     String   @id @default(uuid()) @db.VarChar(36)
  nome   String   @unique @db.VarChar(191)
  utenti Utente[]
}

enum RuoloUtente {
  CITTADINO
  COMITATO
}

enum StatoAccount {
  ATTIVO
  SOSPESO
}

model Utente {
  id                 String       @id @default(uuid()) @db.VarChar(36)
  nome               String       @db.VarChar(100)
  cognome            String       @db.VarChar(100)
  email_normalizzata String       @unique @db.VarChar(191)
  password_hash      String       @db.VarChar(255)
  verificato_il      DateTime?
  ruolo              RuoloUtente  @default(CITTADINO)
  stato_account      StatoAccount @default(ATTIVO)
  quartiere_id       String?      @db.VarChar(36)
  creato_il          DateTime     @default(now())

  quartiere         Quartiere?             @relation(fields: [quartiere_id], references: [id], onDelete: Restrict)
  segnalazioni      Segnalazione[]
  sostegni          Sostegno[]
  eventi_stato      EventoStato[]
  audit             AuditEvento[]
  upload_temporanei UploadTemporaneo[]
  token_account     TokenAccount[]
  sessioni          Sessione[]
  richieste_idem    RichiestaIdempotente[]
}

enum StatoAvanzamento {
  RICEVUTA
  PRESA_IN_CARICO
  INVIATA_AI_CANDIDATI
  RITIRATA
}

enum StatoModerazione {
  PENDENTE
  IN_REVISIONE
  APPROVATA
  RIFIUTATA
}

enum OriginePosizione {
  MANUALE
  EXIF_CONFERMATO
}

model Segnalazione {
  id                String           @id @default(uuid()) @db.VarChar(36)
  autore_id         String           @db.VarChar(36)
  descrizione       String           @db.Text
  latitudine        Float
  longitudine       Float
  origine_posizione OriginePosizione
  stato_avanzamento StatoAvanzamento @default(RICEVUTA)
  stato_moderazione StatoModerazione @default(PENDENTE)
  revisione         Int              @default(1)
  creata_il         DateTime         @default(now())
  aggiornata_il     DateTime         @updatedAt

  autore         Utente                  @relation(fields: [autore_id], references: [id], onDelete: Restrict)
  media          Media[]
  sostegni       Sostegno[]
  categorie      SegnalazioneCategoria[]
  eventi_stato   EventoStato[]
  audit          AuditEvento[]
  analisi_ia     AnalisiIa[]
  outbox         Outbox[]
  richieste_idem RichiestaIdempotente[]

  @@index([stato_moderazione, stato_avanzamento, creata_il, id])
}

enum TipoMedia {
  FOTO
  VIDEO
}

enum StatoFile {
  READY
  QUARANTENA
  ERRORE
}

model Media {
  id              String    @id @default(uuid()) @db.VarChar(36)
  segnalazione_id String    @db.VarChar(36)
  storage_key     String    @unique @db.VarChar(191)
  tipo            TipoMedia
  mime            String    @db.VarChar(100)
  byte_size       Int
  durata_secondi  Int?
  sha256          String    @db.VarChar(64)
  stato_file      StatoFile @default(READY)
  exif_lat        Float?
  exif_lon        Float?
  derivato_key    String?   @unique @db.VarChar(191)
  creato_il       DateTime  @default(now())

  segnalazione Segnalazione @relation(fields: [segnalazione_id], references: [id], onDelete: Restrict)
  analisi_ia   AnalisiIa[]

  @@unique([id, segnalazione_id])
  @@index([segnalazione_id])
}

model Sostegno {
  utente_id       String   @db.VarChar(36)
  segnalazione_id String   @db.VarChar(36)
  creato_il       DateTime @default(now())

  utente       Utente       @relation(fields: [utente_id], references: [id], onDelete: Restrict)
  segnalazione Segnalazione @relation(fields: [segnalazione_id], references: [id], onDelete: Restrict)

  @@id([utente_id, segnalazione_id])
  @@index([segnalazione_id])
}

model Categoria {
  id     String  @id @default(uuid()) @db.VarChar(36)
  codice String  @unique @db.VarChar(191)
  nome   String  @db.VarChar(100)
  attiva Boolean @default(true)

  segnalazioni SegnalazioneCategoria[]
  suggerimenti SuggerimentoCategoria[]
}

model SegnalazioneCategoria {
  segnalazione_id String @db.VarChar(36)
  categoria_id    String @db.VarChar(36)

  segnalazione Segnalazione @relation(fields: [segnalazione_id], references: [id], onDelete: Restrict)
  categoria    Categoria    @relation(fields: [categoria_id], references: [id], onDelete: Restrict)

  @@id([segnalazione_id, categoria_id])
}

enum TipoAttore {
  UTENTE
  SISTEMA
}

enum AmbitoEvento {
  AVANZAMENTO
  MODERAZIONE
}

model EventoStato {
  id              String       @id @default(uuid()) @db.VarChar(36)
  segnalazione_id String       @db.VarChar(36)
  attore_id       String?      @db.VarChar(36)
  tipo_attore     TipoAttore
  ambito          AmbitoEvento
  da_stato        String?      @db.VarChar(50)
  a_stato         String       @db.VarChar(50)
  motivazione     String       @db.Text
  revisione       Int
  creato_il       DateTime     @default(now())

  segnalazione Segnalazione @relation(fields: [segnalazione_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attore       Utente?      @relation(fields: [attore_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([segnalazione_id, creato_il, id])
}

model AuditEvento {
  id              String     @id @default(uuid()) @db.VarChar(36)
  attore_id       String?    @db.VarChar(36)
  tipo_attore     TipoAttore
  segnalazione_id String?    @db.VarChar(36)
  azione          String     @db.VarChar(100)
  request_id      String?    @db.VarChar(100)
  dati_json       String?    @db.Text
  creato_il       DateTime   @default(now())

  attore       Utente?       @relation(fields: [attore_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  segnalazione Segnalazione? @relation(fields: [segnalazione_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

enum ModuloIA {
  MODERAZIONE
  CLASSIFICAZIONE
  EXIF
  COERENZA
}

enum StatoEsecuzione {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  OBSOLETE
}

model AnalisiIa {
  id               String          @id @default(uuid()) @db.VarChar(36)
  segnalazione_id  String          @db.VarChar(36)
  media_id         String?         @db.VarChar(36)
  revisione        Int
  modulo           ModuloIA
  versione_modello String          @db.VarChar(64)
  versione_policy  String          @db.VarChar(64)
  input_hash       String          @db.VarChar(64)
  stato_esecuzione StatoEsecuzione @default(QUEUED)
  esito            String?         @db.VarChar(50)
  punteggio        Float?
  dettagli_json    String?         @db.Text
  tentativi        Int             @default(0)
  creata_il        DateTime        @default(now())
  completata_il    DateTime?

  segnalazione Segnalazione            @relation(fields: [segnalazione_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media        Media?                  @relation(fields: [media_id, segnalazione_id], references: [id, segnalazione_id], onDelete: Restrict, onUpdate: Restrict)
  suggerimenti SuggerimentoCategoria[]

  @@unique([segnalazione_id, revisione, modulo, input_hash, versione_modello, versione_policy], name: "chiave_idempotenza")
  @@index([stato_esecuzione, creata_il])
}

model SuggerimentoCategoria {
  analisi_id   String @db.VarChar(36)
  categoria_id String @db.VarChar(36)
  confidenza   Float?

  analisi   AnalisiIa @relation(fields: [analisi_id], references: [id], onDelete: Restrict)
  categoria Categoria @relation(fields: [categoria_id], references: [id], onDelete: Restrict)

  @@id([analisi_id, categoria_id])
}

enum StatoUpload {
  IN_CARICAMENTO
  VALIDO
  SCARTATO
  CONSUMATO
}

model UploadTemporaneo {
  id              String      @id @default(uuid()) @db.VarChar(36)
  proprietario_id String      @db.VarChar(36)
  storage_key     String      @unique @db.VarChar(191)
  tipo            TipoMedia
  mime            String      @db.VarChar(100)
  byte_size       Int
  sha256          String      @db.VarChar(64)
  durata_secondi  Int?
  exif_lat        Float?
  exif_lon        Float?
  stato           StatoUpload @default(IN_CARICAMENTO)
  scade_il        DateTime
  consumato_il    DateTime?

  proprietario Utente @relation(fields: [proprietario_id], references: [id], onDelete: Restrict)
}

enum TipoToken {
  VERIFICA_EMAIL
  RESET_PASSWORD
}

model TokenAccount {
  id         String    @id @default(uuid()) @db.VarChar(36)
  utente_id  String    @db.VarChar(36)
  tipo       TipoToken
  token_hash String    @unique @db.VarChar(64)
  scade_il   DateTime
  usato_il   DateTime?
  creato_il  DateTime  @default(now())

  utente Utente @relation(fields: [utente_id], references: [id], onDelete: Restrict)
}

model Sessione {
  id          String    @id @default(uuid()) @db.VarChar(36)
  utente_id   String    @db.VarChar(36)
  token_hash  String    @unique @db.VarChar(64)
  scade_il    DateTime
  revocata_il DateTime?
  creato_il   DateTime  @default(now())

  utente Utente @relation(fields: [utente_id], references: [id], onDelete: Restrict)
}

model Outbox {
  id                    String    @id @default(uuid()) @db.VarChar(36)
  segnalazione_id       String    @db.VarChar(36)
  revisione             Int
  tipo_evento           String    @db.VarChar(100)
  payload_json          String    @db.Text
  creata_il             DateTime  @default(now())
  elaborata_il          DateTime?
  tentativi             Int       @default(0)
  prossimo_tentativo_il DateTime?

  segnalazione Segnalazione @relation(fields: [segnalazione_id], references: [id], onDelete: Restrict)

  @@unique([segnalazione_id, revisione, tipo_evento])
  @@index([elaborata_il, prossimo_tentativo_il])
}

model RichiestaIdempotente {
  utente_id       String   @db.VarChar(36)
  chiave          String   @db.VarChar(191)
  payload_hash    String   @db.VarChar(64)
  segnalazione_id String?  @db.VarChar(36)
  stato           String   @db.VarChar(50)
  scade_il        DateTime

  utente       Utente        @relation(fields: [utente_id], references: [id], onDelete: Restrict)
  segnalazione Segnalazione? @relation(fields: [segnalazione_id], references: [id], onDelete: Restrict)

  @@id([utente_id, chiave])
}
